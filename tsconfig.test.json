{
  // The base tsconfig has `include: ["src"]` and `exclude: [..., "tests"]`, so
  // `tsc --noEmit` does not typecheck the test suite at all — and vitest runs
  // through esbuild, which strips types without checking them. Without this
  // file a test can reference a field that does not exist and nothing says so.
  //
  // Kept separate rather than widening the base config: the base one drives the
  // published build, and tests must not end up in dist/. `rootDir` is widened
  // to the repo root because the base pins it to src/.
  "extends": "./tsconfig.json",
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The tests import node builtins. @types/node was only ever reaching this
    // program by accident: vitest 3's public types re-exported
    // vite/dist/node/index.d.ts, which carries `/// <reference types="node" />`.
    // vitest 5 no longer pulls that file in, so name the types explicitly.
    "types": ["node"]
  }
}
